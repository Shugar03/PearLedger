{
  "name": "pearledger-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard operativo PearLedger — capa humana (Evelin)",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.pearledger.app",
    "productName": "PearLedger",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "../dist/dashboard/web/**/*",
      "../dist/ipc/**/*",
      "../dist/**/*.js",
      "!../dist/**/*.test.js"
    ],
    "extraResources": [
      {
        "from": "../out/win32-x64",
        "to": "bin",
        "filter": ["pearledger.exe"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "PearLedger-${version}-Setup.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8"
  }
}
