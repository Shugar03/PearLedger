{
  "name": "pearledger-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Capa humana de PearLedger — dashboard React (web + Electron)",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "electron .",
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.pearledger.app",
    "productName": "PearLedger",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "../dist/dashboard/web/**/*",
      "../dist/ipc/**/*",
      "../dist/**/*.js",
      "!../dist/**/*.test.js",
      "!../dist/**/*.map"
    ],
    "extraResources": [
      {
        "from": "../out/win32-x64",
        "to": "bin",
        "filter": ["pearledger.exe"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "PearLedger-${version}-Setup.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2"
  }
}
