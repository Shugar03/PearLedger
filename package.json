{
  "name": "pearledger",
  "version": "0.1.0",
  "description": "Agente local de operaciones financieras, tesorería y logística P2P — Aleph Hackathon 2026",
  "type": "module",
  "main": "app.js",
  "bin": {
    "pearledger": "./bin.mjs"
  },
  "scripts": {
    "start": "pear run bin.mjs",
    "dev": "tsx bin.mjs",
    "make": "pear build",
    "upgrade": "pear://REPLACE_AFTER_PEAR_TOUCH",
    "stage": "pear stage alpha",
    "provision": "pear provision alpha",
    "mcp": "wdk-mcp",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "dependencies": {
    "@qvac/sdk": "^0.17.0",
    "@tetherto/wdk-cli": "1.0.0-beta.2",
    "@tetherto/wdk-wallet-evm-7702-gasless": "1.0.0-beta.4",
    "@tetherto/wdk-wallet-evm-erc-4337": "1.0.0-beta.16",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0"
  },
  "keywords": [
    "pear",
    "qvac",
    "wdk",
    "p2p",
    "gasless",
    "local-first",
    "hackathon",
    "aleph"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shugar03/PearLedger.git"
  }
}
