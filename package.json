{
  "name": "pear-ledger",
  "version": "0.1.0",
  "description": "Agente local de operaciones financieras, tesorería y logística P2P — Hackathon Aleph 2026",
  "productName": "pearledger",
  "private": false,
  "bin": {
    "pearledger": "./dist/bin.js"
  },
  "upgrade": "pear://rxqrpu8fxa8fes4izqr8gprfq1facxnr9b37tinxdkrpad7bkq5o",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "node:fs": {
      "bare": "bare-fs",
      "default": "node:fs"
    },
    "fs/promises": {
      "bare": "bare-fs/promises",
      "default": "fs/promises"
    },
    "node:fs/promises": {
      "bare": "bare-fs/promises",
      "default": "node:fs/promises"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "node:path": {
      "bare": "bare-path",
      "default": "node:path"
    },
    "url": {
      "bare": "bare-url",
      "default": "url"
    },
    "node:url": {
      "bare": "bare-url",
      "default": "node:url"
    },
    "os": {
      "bare": "bare-os",
      "default": "os"
    },
    "node:os": {
      "bare": "bare-os",
      "default": "node:os"
    },
    "process": {
      "bare": "bare-process",
      "default": "process"
    },
    "node:process": {
      "bare": "bare-process",
      "default": "node:process"
    },
    "child_process": {
      "bare": "bare-subprocess",
      "default": "child_process"
    },
    "node:child_process": {
      "bare": "bare-subprocess",
      "default": "node:child_process"
    },
    "events": {
      "bare": "bare-events",
      "default": "events"
    },
    "node:events": {
      "bare": "bare-events",
      "default": "node:events"
    },
    "crypto": {
      "bare": "bare-crypto",
      "default": "crypto"
    },
    "node:crypto": {
      "bare": "bare-crypto",
      "default": "node:crypto"
    },
    "http": {
      "bare": "bare-http1",
      "default": "http"
    },
    "node:http": {
      "bare": "bare-http1",
      "default": "node:http"
    }
  },
  "scripts": {
    "gen:meta": "node scripts/build/gen-meta.ts",
    "build": "npm run gen:meta && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && npm run build:web",
    "build:web": "node scripts/build/copy-web.ts",
    "build:ts": "npm run build",
    "clean": "node scripts/build/clean.ts",
    "start": "bare dist/bin.js --no-updates",
    "prestart": "npm run build",
    "dev": "node --use-system-ca dist/dev.js",
    "predev": "npm run build",
    "dashboard": "node --use-system-ca dist/dev.js dashboard",
    "predashboard": "npm run build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "lint:rules": "node scripts/check-conventions.ts",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "test:watch": "node --test --watch \"dist/**/*.test.js\"",
    "make": "node scripts/make.ts",
    "make:darwin-arm64": "bare-build --name pearledger --standalone --host darwin-arm64 --out ./out/darwin-arm64 dist/bin.js",
    "make:darwin-x64": "bare-build --name pearledger --standalone --host darwin-x64 --out ./out/darwin-x64 dist/bin.js",
    "make:linux-arm64": "bare-build --name pearledger --standalone --host linux-arm64 --out ./out/linux-arm64 dist/bin.js",
    "make:linux-x64": "bare-build --name pearledger --standalone --host linux-x64 --out ./out/linux-x64 dist/bin.js",
    "make:win32-arm64": "bare-build --name pearledger --standalone --host win32-arm64 --out ./out/win32-arm64 dist/bin.js",
    "make:win32-x64": "bare-build --name pearledger --standalone --host win32-x64 --out ./out/win32-x64 dist/bin.js",
    "pear:build": "pear build --target ../pearledger-deployment",
    "models:download": "npm run build && node dist/scripts/download-models.js",
    "fixtures:seed": "npm run build && node dist/scripts/seed-fixtures.js",
    "mcp": "npm run build && node --use-system-ca --env-file=.env dist/workers/pearledger-mcp.js",
    "mcp:status": "npm run build && node --use-system-ca --env-file=.env dist/workers/pearledger-mcp.js --status",
    "mcp:setup": "node --use-system-ca dist/workers/pearledger-mcp.js --setup",
    "test:mcp": "npm run build && node --test --test-concurrency=1 \"dist/workers/mcp*.test.js\"",
    "wdk:mcp": "node --use-system-ca --env-file=.env dist/workers/wdk-worker.js",
    "wdk:mcp:status": "node --use-system-ca --env-file=.env dist/workers/wdk-worker.js --status",
    "ui:install": "npm install --prefix ui",
    "ui:dev": "npm run build && npm run ui:install && npm run dev --prefix ui",
    "smoke": "npm run build && node dist/scripts/smoke.js",
    "bench": "npm run build && node dist/scripts/bench-ingest.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@qvac/sdk": "^0.17.1",
    "@tetherto/wdk-cli": "1.0.0-beta.2",
    "@tetherto/wdk-wallet-evm-7702-gasless": "1.0.0-beta.4",
    "@tetherto/wdk-wallet-evm-erc-4337": "1.0.0-beta.16",
    "bare-console": "^6.2.0",
    "bare-daemon": "^1.2.4",
    "bare-file-logger": "^1.2.1",
    "bare-fs": "^4.7.2",
    "bare-node-runtime": "^1.5.0",
    "bare-os": "^3.9.0",
    "bare-path": "^3.0.0",
    "bare-process": "^4.5.0",
    "bare-storage": "^1.1.0",
    "bare-url": "^2.5.2",
    "bufferutil": "^4.1.0",
    "corestore": "^7.9.2",
    "fs-native-extensions": "^1.5.0",
    "hyperswarm": "^4.17.0",
    "paparam": "^1.10.1",
    "pear-runtime": "^1.1.4",
    "ready-resource": "^1.2.0",
    "utf-8-validate": "^6.0.6",
    "which-runtime": "^1.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bare": "^1.31.2",
    "bare-build": "^1.0.1",
    "bare-runtime": "^1.29.5",
    "prettier": "^3.6.2",
    "tsc-alias": "^1.9.2",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Shugar03/PearLedger.git"
  },
  "keywords": [
    "pear",
    "qvac",
    "wdk",
    "gasless",
    "local-first",
    "p2p",
    "hackathon",
    "aleph"
  ],
  "author": "Sebastian Villarreal Paz",
  "license": "Apache-2.0",
  "main": "./dist/ipc/bridge.js",
  "types": "./dist/ipc/bridge.d.ts",
  "pear": {
    "name": "pearledger",
    "stage": {
      "ignore": [
        "/.git",
        "/.github",
        "/node_modules",
        "/out",
        "/vendor",
        "/tests",
        "/scripts",
        "/docs",
        "/ui",
        "/src",
        "/.storage-demo",
        "/.storage-pear-ci",
        "/pear-stage",
        "/deployment",
        "/.env",
        "/.env.example",
        "**/node_modules",
        "**/*.log",
        "**/.DS_Store"
      ]
    }
  }
}
