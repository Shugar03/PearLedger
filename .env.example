# PearLedger — copiá este archivo a `.env` y completá lo que necesites.
# Todas las variables se validan al arrancar contra el esquema de src/config.

# ─── Seguridad ───────────────────────────────────────────────────────────────
# Umbral por encima del cual un pago EN VIVO exige confirmación humana explícita.
HUMAN_CONFIRM_THRESHOLD_USDT=1000

# Exige una orden de compra conciliada antes de permitir un pago en vivo.
PEARLEDGER_REQUIRE_MATCH=true

# ─── Wallet ──────────────────────────────────────────────────────────────────
# OBLIGATORIA para operar. Si falta, la app falla con un error claro en vez de
# caer a una wallet por defecto.
#
# ⚠️  NO uses aquí la frase de test pública de BIP-39
# ("abandon abandon … about"): sus fondos los barren bots en segundos. Antes
# venía como valor por defecto en este archivo y en el código; ya no.
# Para demos en Sepolia con esa frase, poné WDK_ALLOW_TEST_SEED=true y quedará
# registrado en el log. En mainnet está prohibida siempre.
WDK_SEED_PHRASE=
# WDK_ALLOW_TEST_SEED=false

# ─── WDK Gasless — Mainnet (EIP-7702) ────────────────────────────────────────
PIMLICO_API_KEY=                        # https://pimlico.io
# CANDIDE_API_KEY=                      # alternativa: https://candide.dev
# WDK_SPONSORSHIP_POLICY_ID=            # opcional (policy de Pimlico)
# WDK_BUNDLER_URL=https://api.pimlico.io/v2/1/rpc
# MAINNET_RPC_URL=https://rpc.mevblocker.io/fast
# WDK_DELEGATION_ADDRESS=0xe6Cae83BdE06E4c305530e199D7217f42808555B
# WDK_PAYMASTER_ADDRESS=0x8888888888888888888888888888888888882402

# Dirección real de USDt en mainnet — 40 dígitos hex.
# El valor anterior de este archivo tenía 42 y hacía fallar toda operación en
# mainnet con "Invalid EVM address". Normalmente no hace falta tocarla.
# WDK_USDT_MAINNET=0xdAC17F958D2ee523a2206206994597C13D831ec7

# ─── WDK Gasless — Sepolia (ERC-4337) ────────────────────────────────────────
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# SEPOLIA_RPC_FALLBACKS=https://1rpc.io/sepolia,https://sepolia.drpc.org
# WDK_BUNDLER_URL_SEPOLIA=https://api.pimlico.io/v2/11155111/rpc
# WDK_SEPOLIA_GAS_MODE=native           # fuerza Candide + ETH si Pimlico falla
# WDK_MOCK_USDT_SEPOLIA=0xd077A400968890Eacc75cdc901F0356c943e4fDb
# WDK_SAFE_MODULES_VERSION=0.3.0

# ─── QVAC (OCR / LLM / RAG locales) ──────────────────────────────────────────
# QVAC_CTX_SIZE=4096
# QVAC_OCR_PATH=auto                    # auto | latin | multimodal
# QVAC_OCR_PATH_B_TIMEOUT_MS=45000
# QVAC_OCR_MAX_EDGE=896
# QVAC_HOME=

# ─── Conciliación de facturas ────────────────────────────────────────────────
# PEARLEDGER_STRICT_INVOICE=true
# PEARLEDGER_VENDOR_MIN_SIM=0.34

# ─── Dashboard (dev server) ──────────────────────────────────────────────────
# PEARLEDGER_DASHBOARD_PORT=7331
# Permitir pagos EN VIVO desde el navegador. Apagado por defecto a propósito:
# el dashboard es solo lectura + dry-run.
# PEARLEDGER_DASHBOARD_ALLOW_LIVE=false

# ─── Rutas y diagnóstico ─────────────────────────────────────────────────────
# PEARLEDGER_WORKSPACE=                 # sobrescribe dónde viven los datos
# PEARLEDGER_DATA_DIR=
# PEARLEDGER_LOG_LEVEL=info             # silent | error | warn | info | debug

# ─── Pear ────────────────────────────────────────────────────────────────────
PEAR_PRIMARY_KEY=                       # clave para pear-ci (secret de GitHub)
